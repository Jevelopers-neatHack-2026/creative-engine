{
  "name": "creative-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Creative contract proposals and standalone conformance fixtures",
  "type": "module",
  "engines": {
    "node": ">=22.23.3"
  },
  "types": "src/contracts/index.d.mts",
  "exports": {
    "./contracts": {
      "types": "./src/contracts/index.d.mts",
      "import": "./src/contracts/index.mjs"
    },
    "./contracts/creative/v1": {
      "types": "./src/contracts/creative/v1.d.mts",
      "import": "./src/contracts/creative/v1.mjs"
    },
    "./contracts/decision-port/v1": {
      "types": "./src/contracts/decision-port/v1.d.mts",
      "import": "./src/contracts/decision-port/v1.mjs"
    }
  },
  "scripts": {
    "bootstrap": "npm ci --ignore-scripts --offline",
    "build": "node scripts/runtime-check.mjs && node --check src/contracts/validation.mjs && node --check src/contracts/scope.mjs && node --check src/contracts/creative/v1.mjs && node --check src/contracts/decision-port/v1.mjs && node --check src/contracts/index.mjs",
    "check:contracts": "node --test tests/contracts/creative-contract.test.mjs tests/contracts/fixture-manifest.test.mjs tests/contracts/dependency-boundary.test.mjs tests/contracts/acceptance-gate.test.mjs",
    "check:decision-contract": "node --test tests/contracts/decision-port.test.mjs tests/contracts/fixture-manifest.test.mjs tests/contracts/dependency-boundary.test.mjs tests/contracts/acceptance-gate.test.mjs",
    "test": "node --test tests/contracts/*.test.mjs"
  }
}
